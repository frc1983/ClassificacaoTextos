---
import Icon from './Icon.astro';
import { homeTrust } from '../data/home';
---
<section class="mv-hub-trust">
  <div class="mv-container">
    <div class="mv-hub-trust-grid">
      {homeTrust.map((item) => (
        <div class="mv-hub-trust-item">
          <div class="mv-diff-icon">
            <Icon name={item.icon} size={24} />
          </div>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
