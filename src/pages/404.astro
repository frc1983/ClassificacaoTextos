---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Página não encontrada | Manejo Vertical"
  description="A página que você procura não existe."
  path="/404/"
>
  <main class="mv-container" style="padding: 8rem 1.5rem 4rem; text-align: center;">
    <h1 class="mv-section-title">Página não encontrada</h1>
    <p class="mv-section-desc" style="margin: 1rem auto 2rem;">O endereço pode ter mudado. Volte à página inicial ou escolha um serviço.</p>
    <p>
      <a class="mv-btn-primary" href="/">Ir para o início</a>
    </p>
  </main>
</BaseLayout>
